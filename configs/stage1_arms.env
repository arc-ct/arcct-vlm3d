# Training settings of every Stage-1 checkpoint used in a final submission.
# Each line is the environment passed to training/train_arm.sh. Settings not
# listed are the train_arm.sh defaults (asl loss, 6 epochs, batch 8, lr 1e-4,
# AdamW wd 1e-4, cosine schedule, flips + random crop + 30 HU intensity jitter).
# RADCHEST = path of the cache written by training/build_radchest_cache.py.

# --- classification submission (and report generation where marked) ---
ARM=rc_r2p1d  RAC_R3D_ARCH=r2plus1d_18 RAC_SEED=0 RAC_EXTRA_TRAIN=$RADCHEST RAC_EXTRA_REPEAT=3   # -> stage1_rc_r2p1d.pt  (cls, weight 3)
ARM=r2p1d     RAC_R3D_ARCH=r2plus1d_18 RAC_SEED=0                                              # -> stage1_r2p1d.pt     (cls, report gen)
ARM=r2p1d_s1  RAC_R3D_ARCH=r2plus1d_18 RAC_SEED=1                                              # -> stage1_r2p1d_s1.pt  (cls, report gen)
ARM=rc_r3d    RAC_R3D_ARCH=r3d_18      RAC_SEED=0 RAC_EXTRA_TRAIN=$RADCHEST RAC_EXTRA_REPEAT=3   # -> stage1_rc_r3d.pt    (cls)
ARM=r3djit    RAC_R3D_ARCH=r3d_18      RAC_SEED=2 RAC_HU_WINDOW_JITTER=0.15                    # -> stage1_r3djit.pt    (cls, report gen)
ARM=mc3_s1    RAC_R3D_ARCH=mc3_18      RAC_SEED=1                                              # -> stage1_mc3_s1.pt    (cls)

# --- report generation only ---
ARM=mc3       RAC_R3D_ARCH=mc3_18      RAC_SEED=0                                              # -> stage1_mc3.pt       (report gen)
